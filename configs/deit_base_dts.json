{
  "entrypoint": "recipes/imagenet_deit/main.py",
  "source_launcher": "run_base_bce_and_ce_k10_scale0.001_frz_last_layer_pt.sh",
  "reference_world_size": 8,
  "arguments": [
    "--model",
    "deit_base_patch16_LS",
    "--data-path",
    "{data_path}",
    "--batch-size",
    "256",
    "--input-size",
    "192",
    "--drop",
    "0.0",
    "--drop-path",
    "0.1",
    "--seed",
    "0",
    "--opt",
    "lamb",
    "--lr",
    "3e-3",
    "--unscale-lr",
    "--weight-decay",
    "0.03",
    "--sched",
    "cosine",
    "--epochs",
    "400",
    "--warmup-epochs",
    "5",
    "--warmup-lr",
    "1e-6",
    "--ThreeAugment",
    "--repeated-aug",
    "--mixup",
    "0.8",
    "--cutmix",
    "1.0",
    "--color-jitter",
    "0.3",
    "--reprob",
    "0.0",
    "--smoothing",
    "0.0",
    "--eval-crop-ratio",
    "1.0",
    "--lfa",
    "--lfa-head-type",
    "independent",
    "--lfa-initial-k",
    "10.0",
    "--lfa-initial-b",
    "0.5",
    "--lfa-loss-type",
    "exponential",
    "--init-lfa-scale",
    "0.001",
    "--decay-lfa-scale",
    "True",
    "--no-decay-last-layer",
    "--output_dir",
    "{output_dir}"
  ]
}
