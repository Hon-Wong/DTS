{
  "entrypoint": "recipes/imagenet_deit/main.py",
  "source_launcher": "run_base_bce_and_ce_k10_scale0.001_frz_last_layer_pt_ft.sh",
  "reference_world_size": 8,
  "arguments": [
    "--model",
    "deit_base_patch16_LS",
    "--data-path",
    "{data_path}",
    "--batch-size",
    "64",
    "--epochs",
    "20",
    "--smoothing",
    "0.1",
    "--reprob",
    "0.0",
    "--opt",
    "adamw",
    "--lr",
    "1e-5",
    "--weight-decay",
    "0.1",
    "--input-size",
    "224",
    "--drop",
    "0.0",
    "--drop-path",
    "0.2",
    "--mixup",
    "0.8",
    "--cutmix",
    "1.0",
    "--unscale-lr",
    "--no-repeated-aug",
    "--aa",
    "rand-m9-mstd0.5-inc1",
    "--eval-crop-ratio",
    "1.0",
    "--finetune",
    "{finetune}",
    "--lfa",
    "--lfa-head-type",
    "independent",
    "--lfa-initial-k",
    "10.0",
    "--lfa-initial-b",
    "0.5",
    "--lfa-loss-type",
    "exponential",
    "--init-lfa-scale",
    "0.00005",
    "--decay-lfa-scale",
    "True",
    "--no-decay-last-layer",
    "--final-loss",
    "ce",
    "--output_dir",
    "{output_dir}"
  ]
}
